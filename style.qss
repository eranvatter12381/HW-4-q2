QWidget {background-color: #f4f6f9;
    font-family: "Segoe UI", Arial;
    font-size: 14px;
    color: #2c3e50;}

QPushButton {background-color: #2ecc71;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;}

QPushButton:hover {background-color: #27ae60;}